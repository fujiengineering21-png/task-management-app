# TaskBoard の開発用データベースの設定（見本）
# 使い方：このファイルをコピーして .env を作り、パスワードを自分だけの値に変える
#   cp .env.example .env
# .env は GitHub に上げない（.gitignore で除外済み）。このファイルには本物のパスワードを書かない
# Docker（compose.yaml）と Spring Boot（application.properties）の両方が、この値を読む
# 値は英数字と _ だけにする（引用符や $ などの記号は、Docker と Spring Boot で読み方が違うため）
# 行の終わりに空白を入れない（Spring Boot だけ空白もパスワードの一部として読み、接続に失敗する）

# データベースの名前・ユーザー名・パスワード（データベースを最初に作ったときだけ使われる）
POSTGRES_DB=taskboard_dev
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=change_me_local_only

# 自分の PC から接続するポート番号（5432 は、PC に直接入れた PostgreSQL とぶつかりやすいので避ける）
TASKBOARD_DB_PORT=5433
